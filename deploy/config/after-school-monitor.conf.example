# Non-secret settings for after-school-healthcheck.service.
# Install as /etc/after-school-service/after-school-monitor.conf with mode 0640.

BACKUP_DIR=/var/backups/after-school-service
MYSQL_DATABASE=after_school_service
# Two backups run per day. Alert at 18 hours, leaving approximately six hours
# to remediate before the documented RPO ceiling of 24 hours is crossed.
BACKUP_MAX_AGE_HOURS=18
BACKUP_SERVICE_NAME=after-school-backup.service

# Optional absolute executable owned by root and not writable by group/others.
# It receives two arguments: state (FAILED or RECOVERED) and a short message.
# Leave empty until email, enterprise chat or another alert channel is chosen.
HEALTH_ALERT_HOOK=
