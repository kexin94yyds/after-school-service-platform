# Non-secret runtime configuration for after-school-service.service.
# Install as /etc/after-school-service/after-school-service.conf with mode 0640.

SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
MANAGEMENT_SERVER_PORT=8082

DB_URL='jdbc:mysql://db.example.internal:3306/after_school_service?connectionTimeZone=%2B08%3A00&forceConnectionTimeZoneToSession=true&sslMode=VERIFY_IDENTITY'
DB_USERNAME=after_school_app
APP_CORS_ALLOWED_ORIGIN='https://after-school.example'

# The JVM reads JAVA_TOOL_OPTIONS automatically. ExitOnOutOfMemoryError lets
# systemd restart a failed process instead of leaving a corrupted JVM alive.
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8'

# DB_PASSWORD must not be placed here. The systemd unit imports the root-only
# /etc/after-school-service/db-password file as a Spring config-tree credential.
# One-time regulator bootstrap values are documented separately and must be
# removed immediately after the first successful login.
