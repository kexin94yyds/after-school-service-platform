[Unit]
Description=After-school service course selection and supervision API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=after-school
Group=after-school
WorkingDirectory=/opt/after-school-service/current
EnvironmentFile=/etc/after-school-service/after-school-service.conf
Environment=SPRING_CONFIG_IMPORT=configtree:/run/credentials/after-school-service.service/
UnsetEnvironment=DB_PASSWORD
LoadCredential=spring.datasource.password:/etc/after-school-service/db-password

ExecStartPre=/usr/bin/test -r /opt/after-school-service/current/app.jar
ExecStart=/usr/bin/java -jar /opt/after-school-service/current/app.jar

Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=mixed
SuccessExitStatus=143

RuntimeDirectory=after-school-service
StateDirectory=after-school-service
UMask=0027
LimitNOFILE=65536
TasksMax=512

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=after-school-service

[Install]
WantedBy=multi-user.target
