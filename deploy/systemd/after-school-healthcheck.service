[Unit]
Description=Local health and backup freshness check for after-school service
After=after-school-service.service

[Service]
Type=oneshot
User=after-school-backup
Group=after-school-backup
EnvironmentFile=/etc/after-school-service/after-school-monitor.conf
Environment=MONITOR_STATE_FILE=/var/lib/after-school-healthcheck/state

ExecStart=/opt/after-school-service/tools/monitor-health.sh
TimeoutStartSec=30s
StateDirectory=after-school-healthcheck
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=after-school-healthcheck
