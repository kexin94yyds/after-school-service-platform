# Copy the values you need into your local process environment.
# Never commit real credentials.
DB_URL=jdbc:mysql://127.0.0.1:3306/after_school_service?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=%2B08%3A00&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=after_school
DB_PASSWORD=replace-with-your-local-password
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
SPRINGDOC_ENABLED=true
RECTIFICATION_MATERIAL_DIR=./data/rectification-materials

# Demo is intentionally not configured through this file. Build the separate
# demo artifact and launch it only with ./scripts/run-demo.sh; that launcher
# ignores DB_URL/DB_USERNAME/DB_PASSWORD and pins demo to after_school_demo.

# Production-only one-time school + school-admin bootstrap. Use only on a
# completely empty production database, then remove all variables immediately.
# APP_BOOTSTRAP_ENABLED=true
# APP_BOOTSTRAP_USERNAME=initial_school_admin
# APP_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
# APP_BOOTSTRAP_DISPLAY_NAME=初始教务管理员
# APP_BOOTSTRAP_SCHOOL_CODE=school-001
# APP_BOOTSTRAP_SCHOOL_NAME=初始化学校
# APP_BOOTSTRAP_DISTRICT_CODE=district-001

# Production must use the prod profile and a CA-verified TLS URL. DB_URL,
# DB_USERNAME and DB_PASSWORD are all required and must be non-empty.
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:mysql://db.example.internal:3306/after_school_service?connectionTimeZone=%2B08%3A00&forceConnectionTimeZoneToSession=true&sslMode=VERIFY_IDENTITY
